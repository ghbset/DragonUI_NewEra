modules\lfg\Assets.lua
modules\lfg\Window.lua
modules\lfg\Roles.lua
modules\lfg\Dungeons.lua
modules\lfg\Raids.lua
modules\lfg\Open.lua

# --- Encounter Journal / Adventure Guide (downport of NewEra/EncounterJournal) ---
